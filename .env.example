# Captaloona Art - Environment Variables
# ========================================
# Copy this file to .env.local and fill in your values

# Supabase Configuration (Required for data persistence)
# Get these from your Supabase project settings: https://app.supabase.com
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Gemini API Key (for AI features)
GEMINI_API_KEY=your-gemini-api-key

# GoHighLevel (GHL) Inbound Webhook — used server-side by the Netlify
# functions (newsletter, bid-notify) to create/tag contacts. Set this in
# the Netlify dashboard, NOT in the browser bundle.
GHL_WEBHOOK_URL=your-ghl-inbound-webhook-url

# Optional: GHL webhook exposed to the client bundle, used only by the
# Contacto form (lib/ghl.ts submitContactToGHL). Prefer GHL_WEBHOOK_URL
# (server-side) for anything new.
VITE_GHL_WEBHOOK_URL=your-ghl-inbound-webhook-url
